PORT=3000
# Optional in GitHub Actions because github.token is injected automatically.
# Still useful for local simulation and as a GitHub App fallback.
GITHUB_TOKEN=ghp_your_token_here
GH_APP_ID=
GH_APP_PRIVATE_KEY=
GH_APP_INSTALLATION_ID=

# goose uses this OpenAI-compatible Chat Completions endpoint.
GOOSE_API_KEY=sk-...
GOOSE_BASE_URL=https://api.openai.com/v1
GOOSE_MODEL=gpt-5.4
GOOSE_THINKING_EFFORT=high

# allow | require_approval | reject
REVIEW_POLICY=require_approval
# Optional repository-specific review rules.
REVIEW_INSTRUCTIONS=
# Comma-separated PR base-branch globs. Empty means all base branches.
REVIEW_BRANCHES=

TRIAGE_ENABLED=true
TRIAGE_LABELS=bug,enhancement,documentation,question,maintenance
TRIAGE_DUPLICATE_LABEL=duplicate
TRIAGE_CANDIDATE_LIMIT=50
TRIAGE_INSTRUCTIONS=

BOT_NAME=github-actions[bot]
AUTO_MERGE=false
MERGE_METHOD=squash
REQUIRE_CHECKS=true
MAX_PATCH_CHARS=120000
LOG_LEVEL=info
