FROM node:24-bookworm

ARG GOOSE_VERSION=v1.46.0
ENV GOOSE_VERSION=${GOOSE_VERSION} \
    GOOSE_BIN_DIR=/usr/local/bin \
    CONFIGURE=false \
    NODE_ENV=production

RUN apt-get update \
    && apt-get install --no-install-recommends -y bash ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh | bash

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

# Action mode does not use this image. Webhook mode is explicitly opt-in.
ENV WEBHOOK_ENABLED=false
EXPOSE 3000
CMD ["node", "dist/src/webhook/server.js"]
