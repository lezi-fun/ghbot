{
  "name": "ghbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "webhook": "node dist/src/webhook/server.js",
    "dev:webhook": "tsx src/webhook/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^21.0.2",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
